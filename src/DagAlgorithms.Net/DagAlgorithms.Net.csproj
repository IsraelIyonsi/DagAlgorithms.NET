<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>DagAlgorithms.Net</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DagAlgorithms.Net</PackageId>
    <Version>0.1.0</Version>
    <Title>DagAlgorithms.NET</Title>
    <Authors>Israel Iyonsi</Authors>
    <Copyright>Copyright (c) 2026 Israel Iyonsi</Copyright>
    <Description>Directed acyclic graph algorithms for .NET: topological sort, cycle detection with the offending path, strongly connected components (Tarjan), and a dependency-respecting async scheduler with bounded parallelism. Zero dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/IsraelIyonsi/DagAlgorithms.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/IsraelIyonsi/DagAlgorithms.NET</PackageProjectUrl>
    <PackageTags>dag;directed-acyclic-graph;topological-sort;cycle-detection;strongly-connected-components;tarjan;scheduler;graph-algorithms</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/IsraelIyonsi/DagAlgorithms.NET/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DagAlgorithms.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
